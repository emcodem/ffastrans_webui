@echo off
REM Builds a nexe base binary (build_tools\windows-x64-<version>) from the OFFICIAL node.exe,
REM no node source build needed: sea-boot.js is injected as Single Executable Application
REM main script and does what nexe's source patches would do. See sea-boot.js for details.
REM Usage: build_base.bat 24.22.1
setlocal
if "%~1"=="" (
    echo Usage: %~nx0 ^<node version^>   e.g. %~nx0 24.22.1
    exit /b 1
)
set NODEVER=%~1
cd /d "%~dp0"

curl -sSfL -o node.exe "https://nodejs.org/dist/v%NODEVER%/win-x64/node.exe" || exit /b 1

REM the blob must be generated by the same node version it gets injected into
node.exe --experimental-sea-config sea-config.json || exit /b 1

copy /Y node.exe "..\windows-x64-%NODEVER%" >NUL
call npx --yes postject@1.0.0-alpha.6 "..\windows-x64-%NODEVER%" NODE_SEA_BLOB sea-prep.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2 || exit /b 1

del node.exe sea-prep.blob
echo Built %~dp0..\windows-x64-%NODEVER%
